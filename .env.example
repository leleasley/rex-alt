# rex-alt configuration. Copy this file to .env and fill in the blanks.
# Everything is read from the environment: no config files or CLI flags.
# Never embed credentials in a URL; keep them in their own variables below.
# Never commit .env (it is gitignored); .env.example contains no real secrets.

# --- Admin API -------------------------------------------------------------
# Port for the admin API (health, status, sync trigger). Default: 9982.
APP_PORT=9982
# Optional externally visible base URL. http(s) only, no userinfo.
PUBLIC_URL=
# Bearer token for the admin API. Must be at least 16 characters when set.
# Generate with: openssl rand -hex 24
API_TOKEN=
# Base64 of exactly 32 random bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# --- State -----------------------------------------------------------------
# SQLite database path inside the container. Default: /data/rex-alt.db
DATABASE_PATH=/data/rex-alt.db

# --- REX -------------------------------------------------------------------
# REX base URL, e.g. http://10.77.77.2:32400. http(s) only, no userinfo.
REX_URL=
# Stable REX source name. Default: rex-alt.
REX_SOURCE_NAME=rex-alt
# REX feed credentials. Sent as separate Basic-auth fields, never in REX_URL.
REX_SOURCE_USER=
REX_SOURCE_PASSWORD=
# Attach TMDB ids to pushed items. Default false: keep false until the merge
# behaviour with existing Zurg-fed titles has been observed.
REX_SEND_TMDB_IDS=false

# --- Altmount WebDAV -------------------------------------------------------
# WebDAV base URL, e.g. http://10.77.77.49:8090/webdav/ (trailing slash).
# http(s) only, no userinfo.
ALTMOUNT_WEBDAV_URL=
ALTMOUNT_WEBDAV_USER=
ALTMOUNT_WEBDAV_PASSWORD=
# Shorter aliases are also accepted; the ALTMOUNT_WEBDAV_* names above win.
ALTMOUNT_USER=
ALTMOUNT_PASSWORD=

# --- TMDB ------------------------------------------------------------------
# v4 read-access token (preferred) or v3 API key. One credential is enough.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# Alias for TMDB_READ_ACCESS_TOKEN, accepted when the canonical name is empty.
TMDB_READ_TOKEN=

# --- Probing ---------------------------------------------------------------
# Concurrent ffprobe workers, 1..8. Default 4 (hard cap 8).
PROBE_WORKERS=4
# Ranged probe timeout. Minimum and default 45s (cold WebDAV files are slow).
PROBE_TIMEOUT=45s
# Per-request HTTP timeout. Default: 15s.
HTTP_TIMEOUT=15s

# --- Sync ------------------------------------------------------------------
# Recurring sync interval. Default: 6h.
SYNC_INTERVAL=6h
# Hour of day (0..23) to start syncs, or -1 to run on the interval with no gate.
SYNC_START_HOUR=-1
# Pilot limits; 0 means unlimited. Try 10 movies / 2 series for the first pass.
SYNC_MAX_MOVIES=0
SYNC_MAX_SERIES=0
# Items per REX feed POST (16 MiB body limit). Default: 100.
PUSH_BATCH=100
